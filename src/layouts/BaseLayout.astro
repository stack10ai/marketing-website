---
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Stack10 delivers enterprise AI transformation measured in production, not promises.',
  canonicalUrl,
  ogImage = 'https://stack10.ai/android-chrome-512x512.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Stack10">
  {canonicalUrl && <meta property="og:url" content={canonicalUrl}>}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="sitemap" href="/sitemap-index.xml">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Stack10",
    "url": "https://stack10.ai",
    "logo": "https://stack10.ai/logo-light.svg",
    "description": "Stack10 designs, builds, and deploys production AI systems for Australian mid-market enterprises — measured in story points and validated ROI.",
    "areaServed": "AU",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "hello@stack10.ai",
      "contactType": "sales"
    },
    "sameAs": [],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Stack10 AI Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Stack Discover",
            "description": "2-week AI opportunity discovery. Surface real AI opportunities from your operational data before a line of code is written.",
            "url": "https://stack10.ai/services/discover/"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Stack Build",
            "description": "Senior AI engineers ship production systems on story points. Full IP transfer. No retainer.",
            "url": "https://stack10.ai/services/build/"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Stack Scale",
            "description": "Embed AI into daily workflows by role. Measured at 30, 60, and 90 days — not slide decks.",
            "url": "https://stack10.ai/services/scale/"
          }
        }
      ]
    }
  }
  </script>
</head>
<body>

  <AnnouncementBar text="Stack Discover — Find your top AI opportunities in 2 weeks" linkHref="/services/discover/" linkText="Learn more →" />

  <Nav />

  <main>
    <slot />
  </main>

  <Footer />

  <SiteScripts />

</body>
</html>
