---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Systems Automation — Agentic Workflows & Enterprise Integrations | Stack10"
  description="From AI agents that reason and act across your systems, to enterprise integrations that finally connect SAP, Salesforce, and legacy platforms — Stack10 builds automation that runs in production."
  canonicalUrl="https://stack10.ai/capabilities/systems-automation/"
>

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="svc-hero hero-dark">
    <div class="container">
      <div class="svc-hero-inner animate-fade-up">
        <span class="section-label svc-hero-label">Capability — Systems Automation</span>
        <h1 class="svc-hero-title">Autonomous systems that execute while your team focuses on what matters.</h1>
        <p class="svc-hero-subtitle">From AI agents that reason and act across your systems, to enterprise integrations that finally connect SAP, Salesforce, and the legacy platform no one wants to touch — we build automation that runs in production, not in theory.</p>
        <div class="svc-hero-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">
            Get Started
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
          <a href="/services/build/" class="btn btn-outline btn-lg">See Stack Build</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHAT WE BUILD ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What we build</span>
        <h2 class="section-title">Six types of automation. One standard: production-ready.</h2>
        <p class="section-desc">Not scripts. Not prototypes. Autonomous systems designed to handle real business volume, with the error handling, observability, and compliance trails your environment requires.</p>
      </div>

      <div class="cap-what-grid">

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
          </div>
          <h3 class="cap-what-title">Agentic Systems</h3>
          <p class="cap-what-desc">AI agents that perceive, reason, plan, and execute multi-step tasks autonomously — with human-in-the-loop gates where compliance or risk requires them. Designed for complex workflows, not just simple triggers.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </div>
          <h3 class="cap-what-title">Enterprise Integrations</h3>
          <p class="cap-what-desc">Production-grade connectors for SAP, Salesforce, Microsoft Dynamics, and legacy systems. Data flows between platforms reliably, bidirectionally, and observably — without breaking every quarter.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </div>
          <h3 class="cap-what-title">Process Automation</h3>
          <p class="cap-what-desc">End-to-end automation of high-volume, rules-heavy processes: compliance submissions, approval workflows, reconciliation, onboarding, invoicing — the repetitive work that consumes your team's time.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="cap-what-title">Compliance Automation</h3>
          <p class="cap-what-desc">Automated audit trails, regulatory reporting, and decision logging for APRA CPS 230, AML/CTF, and internal governance frameworks — so compliance is a by-product of operations, not a separate workstream.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
          </div>
          <h3 class="cap-what-title">Workflow Orchestration</h3>
          <p class="cap-what-desc">Complex multi-step pipelines with conditional routing, error handling, retry logic, and human escalation paths — not just a linear script that breaks the moment something unexpected happens.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="cap-what-title">Legacy System Modernisation</h3>
          <p class="cap-what-desc">AI and automation layers built on top of systems you cannot replace — so you get modern capability without a multi-year re-platform project. The existing system stays. The manual work goes.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── PROOF CALLOUT ─────────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="svc-proof-callout">
        <div class="svc-proof-stat">98%</div>
        <p class="svc-proof-text">A PE-backed Australian healthcare group replaced entirely manual compliance workflows with four interconnected AI systems — a compliance agent, Xero reconciliation, a procurement workflow, and an intelligence layer. The result: <strong>98% reduction in manual compliance processing</strong> within the first quarter, with full APRA audit trails on every automated decision.</p>
      </div>
    </div>
  </section>

  <!-- ── RIGHT FOR YOU IF ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="svc-fit-grid">
        <div class="svc-fit-copy">
          <span class="section-label">Is this right for you?</span>
          <h2 class="section-title">Systems Automation is the right engagement if&hellip;</h2>
        </div>
        <div class="card svc-fit-box">
          <ul class="svc-fit-list">
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Your compliance team manually processes hundreds of documents each week — and every step of that should be automated</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Data lives in three systems and someone manually reconciles it every Monday morning — that person has better things to do</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You want an AI agent that handles a complex workflow end-to-end — from trigger to resolution — without a human touching it in the normal case</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You have an integration between SAP and Salesforce that breaks once a month and nobody knows why — until a customer notices</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>A regulatory deadline is forcing you to produce audit trails and compliance reports that your current systems cannot generate automatically</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT'S DELIVERED ────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="cap-delivery">
        <div class="cap-delivery-copy">
          <span class="section-label">How it's delivered</span>
          <h2 class="section-title">Every automation is built through the Stack Build Method.</h2>
          <p class="section-desc">Story-point pricing agreed before work starts. Senior engineers only — no juniors on delivery. Compliance architecture and audit trails defined in week one. Full IP transfer on completion. No ongoing dependency on Stack10 to keep your automations running.</p>
          <div class="cap-delivery-links">
            <a href="/services/build/" class="btn btn-primary">
              See Stack Build
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/how-we-build/" class="btn btn-outline">
              See the method
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
        <div class="cap-delivery-integrations card">
          <span class="cap-delivery-integrations-label">Systems we integrate with</span>
          <div class="cap-delivery-integrations-grid">
            <span class="cap-delivery-integration">SAP</span>
            <span class="cap-delivery-integration">Salesforce</span>
            <span class="cap-delivery-integration">Microsoft Dynamics</span>
            <span class="cap-delivery-integration">Xero</span>
            <span class="cap-delivery-integration">MYOB</span>
            <span class="cap-delivery-integration">ServiceNow</span>
            <span class="cap-delivery-integration">Legacy Systems</span>
            <span class="cap-delivery-integration">Custom APIs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="section section-dark-block">
    <div class="container">
      <div class="svc-cta-inner">
        <h2 class="svc-cta-title">Tell us what your team is doing manually that they shouldn't be.</h2>
        <p class="svc-cta-desc">A Discovery Call is sixty minutes. We will map the process, identify where automation can realistically replace manual work, and tell you exactly what a first engagement would include — before any commitment.</p>
        <div class="svc-cta-guarantees">
          <span class="svc-cta-guarantee">Scope agreed before work starts</span>
          <span class="svc-cta-guarantee">Senior engineers only — no juniors on delivery</span>
          <span class="svc-cta-guarantee">Full IP transfer — everything built is yours</span>
        </div>
        <a href="/contact/" class="btn btn-primary btn-lg">
          Get Started
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── RELATED ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="svc-related-header">
        <span class="section-label">Related capabilities</span>
        <h2 class="section-title">Automation works best with the right layer above and below</h2>
      </div>
      <div class="svc-related-cards">
        <a href="/capabilities/application-development/" class="card card-clickable svc-related-card">
          <div class="svc-related-card-tag">
            <span class="badge badge-secondary">Application Development</span>
          </div>
          <h3 class="svc-related-card-title">The user-facing layer over your automated workflows</h3>
          <p class="svc-related-card-desc">Internal tools and customer-facing products that surface the outputs of your automation — dashboards, approval interfaces, status views — so humans interact where they should and step back where they shouldn't.</p>
          <span class="svc-related-card-link">
            Learn about Application Development
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/capabilities/data-engineering/" class="card card-clickable svc-related-card">
          <div class="svc-related-card-tag">
            <span class="badge badge-secondary">Data Engineering</span>
          </div>
          <h3 class="svc-related-card-title">The data infrastructure your automations depend on</h3>
          <p class="svc-related-card-desc">Pipelines, MCP servers, and data quality infrastructure — so your automated systems read from and write to reliable, accurate data rather than amplifying bad data at scale.</p>
          <span class="svc-related-card-link">
            Learn about Data Engineering
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .svc-hero {
    background: var(--gray-1000);
    color: var(--gray-50);
    padding: var(--space-24) 0 var(--space-20);
    border-bottom: 1px solid var(--gray-800);
  }

  .svc-hero-inner { max-width: 56rem; }

  .svc-hero-label {
    margin-bottom: var(--space-6);
  }

  .svc-hero-title {
    font-size: clamp(2.25rem, 5.5vw, var(--size-6xl));
    font-weight: var(--weight-800);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--gray-0);
    margin-bottom: var(--space-6);
  }

  .svc-hero-subtitle {
    font-size: clamp(1.125rem, 2vw, var(--size-xl));
    font-weight: var(--weight-500);
    color: var(--gray-400);
    line-height: 1.65;
    max-width: 44rem;
    margin-bottom: var(--space-10);
  }

  .svc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .svc-hero-actions .btn-outline {
    background-color: var(--background);
  }

  /* ── What we build grid ───────────────────────────────────────── */
  .cap-what-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .cap-what-card {
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cap-what-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-12);
    color: var(--primary-text);
    flex-shrink: 0;
  }

  .cap-what-title {
    font-size: var(--size-lg);
    font-weight: var(--weight-700);
    color: var(--foreground);
    line-height: 1.3;
    margin: 0;
  }

  .cap-what-desc {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Proof callout ────────────────────────────────────────────── */
  .section-muted { background: var(--muted); }

  .svc-proof-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    background: var(--background);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .svc-proof-stat {
    font-family: var(--font-mono);
    font-size: var(--size-5xl);
    font-weight: var(--weight-800);
    color: var(--primary-text);
    line-height: 1;
    flex-shrink: 0;
    letter-spacing: -0.03em;
  }

  .svc-proof-text {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.7;
    margin: 0;
    align-self: center;
  }

  .svc-proof-text strong {
    color: var(--foreground);
    font-weight: var(--weight-600);
  }

  /* ── Right for you ────────────────────────────────────────────── */
  .svc-fit-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-16);
    align-items: start;
  }

  .svc-fit-box { padding: var(--space-8); }

  .svc-fit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .svc-fit-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    font-size: var(--size-base);
    color: var(--foreground);
    line-height: 1.6;
  }

  .svc-fit-icon {
    flex-shrink: 0;
    color: var(--primary);
    margin-top: 2px;
  }

  /* ── How it's delivered ───────────────────────────────────────── */
  .cap-delivery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .cap-delivery-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .cap-delivery-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .cap-delivery-integrations {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cap-delivery-integrations-label {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: var(--weight-700);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .cap-delivery-integrations-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cap-delivery-integration {
    font-size: var(--size-sm);
    font-weight: var(--weight-500);
    color: var(--foreground);
    padding: var(--space-2) var(--space-4);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  /* ── CTA band ─────────────────────────────────────────────────── */
  .section-dark-block {
    background: var(--gray-950);
    color: var(--gray-50);
  }

  .svc-cta-inner { max-width: 48rem; }

  .svc-cta-title {
    font-size: clamp(1.75rem, 3.5vw, var(--size-4xl));
    font-weight: var(--weight-700);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--gray-50);
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }

  .svc-cta-desc {
    font-size: var(--size-lg);
    color: var(--gray-400);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .svc-cta-guarantees {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .svc-cta-guarantee {
    font-size: var(--size-sm);
    font-weight: var(--weight-500);
    color: var(--gray-300);
    font-family: var(--font-mono);
    padding: var(--space-2) var(--space-4);
    background: var(--gray-900);
    border: 1px solid var(--gray-700);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* ── Related ─────────────────────────────────────────────────── */
  .svc-related-header { margin-bottom: var(--space-8); }

  .svc-related-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: var(--space-6);
  }

  .svc-related-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
  }

  .svc-related-card-tag { display: flex; }

  .svc-related-card-title {
    font-size: var(--size-xl);
    font-weight: var(--weight-700);
    color: var(--foreground);
    line-height: 1.3;
    margin: 0;
  }

  .svc-related-card-desc {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .svc-related-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--size-sm);
    font-weight: var(--weight-600);
    color: var(--primary-text);
    text-decoration: none;
    margin-top: auto;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .cap-what-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .svc-hero { padding: var(--space-16) 0 var(--space-12); }
    .cap-what-grid { grid-template-columns: 1fr; }

    .svc-fit-grid,
    .cap-delivery { grid-template-columns: 1fr; gap: var(--space-8); }

    .svc-proof-callout { flex-direction: column; gap: var(--space-4); }
    .svc-proof-stat { font-size: var(--size-4xl); }
    .svc-cta-guarantees { flex-direction: column; }
    .svc-cta-guarantee { white-space: normal; }
  }
</style>
