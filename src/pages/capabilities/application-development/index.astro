---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Application Development — AI-Powered Apps & Internal Tools | Stack10"
  description="From internal tools that automate hours of daily work to customer-facing AI products — Stack10 builds full-stack AI applications on your data, deployed in your environment, owned by you."
  canonicalUrl="https://stack10.ai/capabilities/application-development/"
>

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="svc-hero hero-dark">
    <div class="container">
      <div class="svc-hero-inner animate-fade-up">
        <span class="section-label svc-hero-label">Capability — Application Development</span>
        <h1 class="svc-hero-title">AI-powered applications built for production, not just the demo.</h1>
        <p class="svc-hero-subtitle">From internal tools that automate hours of daily work to customer-facing AI products that differentiate your offering — full-stack applications built on your data, deployed in your environment, and owned by you permanently.</p>
        <div class="svc-hero-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">
            Get Started
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
          <a href="/services/build/" class="btn btn-outline btn-lg">See Stack Build</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHAT WE BUILD ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What we build</span>
        <h2 class="section-title">Six types of application. One delivery standard.</h2>
        <p class="section-desc">Every application is production-ready from day one — not a prototype that needs rework before it can go live.</p>
      </div>

      <div class="cap-what-grid">

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3 class="cap-what-title">Internal AI Tools</h3>
          <p class="cap-what-desc">Q&amp;A systems over internal documents, intelligent reporting dashboards, automated document processing, and approval workflow tools — built for your team, not a generic use case.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="cap-what-title">Customer-Facing AI Products</h3>
          <p class="cap-what-desc">AI features inside existing products, new AI-native applications, recommendation engines, and prediction interfaces built for end users — differentiated, not bolted on.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="cap-what-title">Conversational AI Systems</h3>
          <p class="cap-what-desc">LLM-powered assistants and chatbots grounded in your own data — not a generic model trained on the internet. Accurate, auditable, and scoped to what you actually need it to do.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="cap-what-title">Proof of Concept Builds</h3>
          <p class="cap-what-desc">A working system on real production data in 6–8 weeks. Built on architecture that extends cleanly into full production — not a demo that gets discarded when the budget cycle opens.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="cap-what-title">AI-Augmented APIs</h3>
          <p class="cap-what-desc">AI capabilities exposed as clean, versioned APIs — ready to integrate with your existing product, mobile application, or enterprise stack without rebuilding what already works.</p>
        </div>

        <div class="card cap-what-card">
          <div class="cap-what-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3 class="cap-what-title">Document Processing Pipelines</h3>
          <p class="cap-what-desc">Automated ingestion, extraction, classification, and routing of high-volume document flows — contracts, invoices, applications, compliance submissions — at the speed your volume demands.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── RIGHT FOR YOU IF ──────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="svc-fit-grid">
        <div class="svc-fit-copy">
          <span class="section-label">Is this right for you?</span>
          <h2 class="section-title">Application Development is the right engagement if&hellip;</h2>
        </div>
        <div class="card svc-fit-box">
          <ul class="svc-fit-list">
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Your team spends hours each week searching through documents for answers an AI should retrieve in seconds</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You have a manual reporting process that touches three systems — it should run automatically each morning</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You want to ship AI-powered features to your customers before your competitor's next release</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You have a proof of concept that worked on sample data — now you need a production build on the real thing</span>
            </li>
            <li class="svc-fit-item">
              <svg class="svc-fit-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>You need a working system with a real user interface — not an API endpoint or a notebook that data scientists poke at</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT'S DELIVERED ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="cap-delivery">
        <div class="cap-delivery-copy">
          <span class="section-label">How it's delivered</span>
          <h2 class="section-title">Every application is built through the Stack Build Method.</h2>
          <p class="section-desc">Story-point pricing agreed before work starts. Senior engineers only — no juniors on delivery. Security architecture defined in week one. Full IP transfer on completion. The same four-phase process, every engagement.</p>
          <div class="cap-delivery-links">
            <a href="/services/build/" class="btn btn-primary">
              See Stack Build
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/how-we-build/" class="btn btn-outline">
              See the method
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
        <div class="cap-delivery-stat card">
          <div class="cap-delivery-stat-number">98%</div>
          <p class="cap-delivery-stat-label">reduction in manual compliance processing — a PE-backed healthcare group, four interconnected AI systems, under ten weeks from kick-off to handover.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="section section-dark-block">
    <div class="container">
      <div class="svc-cta-inner">
        <h2 class="svc-cta-title">Tell us what you need built.</h2>
        <p class="svc-cta-desc">A Discovery Call is sixty minutes. We will scope the application, confirm feasibility on your data, and tell you exactly what a first engagement would include — before any commitment.</p>
        <div class="svc-cta-guarantees">
          <span class="svc-cta-guarantee">Fixed fee — cost agreed before work starts</span>
          <span class="svc-cta-guarantee">Senior engineers only — no juniors on delivery</span>
          <span class="svc-cta-guarantee">Full IP transfer — everything built is yours</span>
        </div>
        <a href="/contact/" class="btn btn-primary btn-lg">
          Get Started
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── RELATED ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="svc-related-header">
        <span class="section-label">Related capabilities</span>
        <h2 class="section-title">Every application needs a foundation</h2>
      </div>
      <div class="svc-related-cards">
        <a href="/capabilities/data-engineering/" class="card card-clickable svc-related-card">
          <div class="svc-related-card-tag">
            <span class="badge badge-secondary">Data Engineering</span>
          </div>
          <h3 class="svc-related-card-title">The data layer that makes your application reliable</h3>
          <p class="svc-related-card-desc">Pipelines, MLOps, MCP servers, and vector infrastructure — the foundation every AI application depends on to produce consistent, accurate results.</p>
          <span class="svc-related-card-link">
            Learn about Data Engineering
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/capabilities/systems-automation/" class="card card-clickable svc-related-card">
          <div class="svc-related-card-tag">
            <span class="badge badge-secondary">Systems Automation</span>
          </div>
          <h3 class="svc-related-card-title">Connect your application to the systems around it</h3>
          <p class="svc-related-card-desc">Agentic workflows, enterprise integrations, and process automation — so your application doesn't sit in isolation but drives action across your organisation.</p>
          <span class="svc-related-card-link">
            Learn about Systems Automation
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .svc-hero {
    background: var(--gray-1000);
    color: var(--gray-50);
    padding: var(--space-24) 0 var(--space-20);
    border-bottom: 1px solid var(--gray-800);
  }

  .svc-hero-inner {
    max-width: 56rem;
  }

  .svc-hero-label {
    color: var(--green-400);
    border-color: oklch(0.76 0.21 150 / 0.3);
    margin-bottom: var(--space-6);
  }

  .svc-hero-title {
    font-size: clamp(2.25rem, 5.5vw, var(--size-6xl));
    font-weight: var(--weight-800);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--gray-0);
    margin-bottom: var(--space-6);
  }

  .svc-hero-subtitle {
    font-size: clamp(1.125rem, 2vw, var(--size-xl));
    font-weight: var(--weight-500);
    color: var(--gray-400);
    line-height: 1.65;
    max-width: 44rem;
    margin-bottom: var(--space-10);
  }

  .svc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* ── What we build grid ───────────────────────────────────────── */
  .cap-what-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .cap-what-card {
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cap-what-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-12);
    color: var(--primary-text);
    flex-shrink: 0;
  }

  .cap-what-title {
    font-size: var(--size-lg);
    font-weight: var(--weight-700);
    color: var(--foreground);
    line-height: 1.3;
    margin: 0;
  }

  .cap-what-desc {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Right for you ────────────────────────────────────────────── */
  .section-muted { background: var(--muted); }

  .svc-fit-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-16);
    align-items: start;
  }

  .svc-fit-box { padding: var(--space-8); }

  .svc-fit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .svc-fit-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    font-size: var(--size-base);
    color: var(--foreground);
    line-height: 1.6;
  }

  .svc-fit-icon {
    flex-shrink: 0;
    color: var(--primary);
    margin-top: 2px;
  }

  /* ── How it's delivered ───────────────────────────────────────── */
  .cap-delivery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .cap-delivery-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .cap-delivery-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .cap-delivery-stat {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cap-delivery-stat-number {
    font-family: var(--font-mono);
    font-size: var(--size-5xl);
    font-weight: var(--weight-800);
    color: var(--primary-text);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cap-delivery-stat-label {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.65;
    margin: 0;
  }

  /* ── CTA band ─────────────────────────────────────────────────── */
  .section-dark-block {
    background: var(--gray-950);
    color: var(--gray-50);
  }

  .svc-cta-inner { max-width: 48rem; }

  .svc-cta-title {
    font-size: clamp(1.75rem, 3.5vw, var(--size-4xl));
    font-weight: var(--weight-700);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--gray-50);
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }

  .svc-cta-desc {
    font-size: var(--size-lg);
    color: var(--gray-400);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .svc-cta-guarantees {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .svc-cta-guarantee {
    font-size: var(--size-sm);
    font-weight: var(--weight-500);
    color: var(--gray-300);
    font-family: var(--font-mono);
    padding: var(--space-2) var(--space-4);
    background: var(--gray-900);
    border: 1px solid var(--gray-700);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* ── Related ─────────────────────────────────────────────────── */
  .svc-related-header { margin-bottom: var(--space-8); }

  .svc-related-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: var(--space-6);
  }

  .svc-related-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
  }

  .svc-related-card-tag { display: flex; }

  .svc-related-card-title {
    font-size: var(--size-xl);
    font-weight: var(--weight-700);
    color: var(--foreground);
    line-height: 1.3;
    margin: 0;
  }

  .svc-related-card-desc {
    font-size: var(--size-base);
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .svc-related-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--size-sm);
    font-weight: var(--weight-600);
    color: var(--primary-text);
    text-decoration: none;
    margin-top: auto;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .cap-what-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .svc-hero {
      padding: var(--space-16) 0 var(--space-12);
    }

    .cap-what-grid {
      grid-template-columns: 1fr;
    }

    .svc-fit-grid,
    .cap-delivery {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .svc-cta-guarantees { flex-direction: column; }
    .svc-cta-guarantee { white-space: normal; }
  }
</style>
