---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroVisual from '../../components/HeroVisual.astro';
---

<BaseLayout
  title="Stack10 — Enterprise AI Transformation | Strategy to Production"
  description="Stack10 designs, builds, and deploys production AI systems for Australian mid-market enterprises — measured in story points and validated ROI, not strategy slides."
  canonicalUrl="https://stack10.ai/"
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero hero-split">
    <div class="hero-dot-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="section-label hero-eyebrow">Enterprise AI Transformation · Australia</div>
      <h1 class="hero-title hero-title-left">
        Your board wants AI&nbsp;results.
        Your consultant delivered&nbsp;a&nbsp;deck.
      </h1>
      <p class="hero-subtitle hero-subtitle-left">
        Stack10 designs, builds, and deploys production AI systems for Australian mid-market enterprises — measured in story points and validated ROI, not strategy slides.
      </p>
      <div class="hero-actions hero-actions-left">
        <a href="/contact/" class="btn btn-primary btn-lg">
          Get Started
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <a href="/how-we-work/" class="btn btn-outline btn-lg">See Our Approach</a>
      </div>
      <p class="hero-microcopy">Fixed-fee engagements &middot; Senior engineers only &middot; No retainer lock-in</p>
    </div>
    <div class="hero-visual-col">
      <HeroVisual />
    </div>
  </section>

  <!-- ── LOGO BAR ──────────────────────────────────────────────── -->
  <div class="logo-bar">
    <div class="logo-bar-label">Trusted by enterprises across financial services, logistics and government</div>
    <div class="logo-bar-grid">
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
    </div>
  </div>

  <!-- ── STATS ─────────────────────────────────────────────────── -->
  <section class="section section-stats section-with-accents">
    <div class="floating-accents" aria-hidden="true">
      <div class="accent-block accent-a1"></div>
      <div class="accent-block accent-a2"></div>
      <div class="accent-block accent-a3"></div>
      <div class="accent-block accent-a4"></div>
      <div class="accent-block accent-a5"></div>
      <div class="accent-block accent-a6"></div>
      <div class="accent-block accent-a7"></div>
      <div class="accent-block accent-a8"></div>
      <div class="accent-block accent-a9"></div>
      <div class="accent-block accent-a10"></div>
    </div>
    <div class="container">
      <div class="stat-bar-dark" data-reveal-stagger>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">95%</div>
          <div class="stat-label">of AI pilots fail before reaching production (MIT)</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">18mo</div>
          <div class="stat-label">Average pilot-to-production timeline (industry)</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">12wk</div>
          <div class="stat-label">Stack10 average: strategy to working system</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">67%</div>
          <div class="stat-label">More output than comparable in-house AI teams</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ───────────────────────────────────────────────── -->
  <section class="section section-problem">
    <div class="container">
      <div class="problem-split" data-reveal>
        <div class="problem-copy">
          <div class="section-label">The problem with AI consulting</div>
          <h2 class="section-title">Traditional firms have a billing problem. You're paying for it.</h2>
          <p class="p1">Legacy consultancies have built their business model around complexity. Senior partners pitch. Juniors deliver. Multi-year roadmaps gather dust. Two-hundred-page decks justify the invoice.</p>
          <p class="p2 problem-body-2">And when the AI pilot stalls? They sell you the next engagement to fix the last one. Worse: when AI is built on broken processes, it doesn't fix your operations — it automates the dysfunction at scale.</p>
        </div>
        <div class="problem-cards" data-reveal-stagger>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;The board approved $200K for AI. Twelve months later: a deck and a stalled proof-of-concept.&rdquo;</p>
          </div>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;We deployed Copilot company-wide. Nobody uses it. Nobody knows why.&rdquo;</p>
          </div>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;We automated a process we didn&rsquo;t understand. Now we have a faster version of the same problem.&rdquo;</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS — 3-phase ────────────────────────────────── -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">How it works</div>
        <h2 class="section-title section-title-center">We replaced advisory with execution and validation.</h2>
        <p class="section-desc section-desc-center">Transformation is measured in working code deployed on optimised processes — not presentations. Choose where to start, based on where you are.</p>
      </div>

      <div class="phases" data-reveal-stagger>

        <div class="phase-card" data-reveal-child>
          <div class="phase-num">01</div>
          <h3 class="phase-title">Discover &amp; Architect</h3>
          <p class="phase-desc">Surface real AI opportunities from your actual operational data. Stakeholder interviews, process intelligence, and tech stack review combine into a prioritised backlog tied to provable ROI — not assumptions.</p>
          <div class="phase-tags">
            <span class="phase-tag">Stack Discover</span>
            <span class="phase-tag">Stack Map</span>
            <span class="phase-tag">Stack Audit</span>
          </div>
        </div>

        <div class="phase-connector" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>

        <div class="phase-card" data-reveal-child>
          <div class="phase-num">02</div>
          <h3 class="phase-title">Build &amp; Deploy</h3>
          <p class="phase-desc">Senior AI engineers ship production systems priced on story points — not hours. Integrated with your existing stack. Every sprint delivers working software, not work-in-progress reports.</p>
          <div class="phase-tags">
            <span class="phase-tag">Stack One</span>
          </div>
        </div>

        <div class="phase-connector" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>

        <div class="phase-card" data-reveal-child>
          <div class="phase-num">03</div>
          <h3 class="phase-title">Validate &amp; Scale</h3>
          <p class="phase-desc">Post-deployment process mining confirms real impact against your pre-build baseline. We surface unintended consequences early, benchmark continuously, and build your scaling playbook. Dashboards, not decks.</p>
          <div class="phase-tags">
            <span class="phase-tag">Stack One</span>
            <span class="phase-tag">Stack Map</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── SERVICES ─────────────────────────────────────────────── -->
  <section class="section section-services">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Our services</div>
        <h2 class="section-title section-title-center">Three products. A clear progression.</h2>
        <p class="section-desc section-desc-center">Every engagement is custom-scoped to your situation. We assess what you need on an initial call and propose the right structure — no menus, no tiers to navigate.</p>
      </div>

      <div class="products-grid" data-reveal-stagger>

        <!-- Stack Discover -->
        <div class="product-card" data-reveal-child>
          <div class="product-card-top">
            <div class="product-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <span class="product-label">Discover</span>
          </div>
          <h3 class="product-name">Stack Discover</h3>
          <p class="product-tagline">The intelligence layer.</p>
          <p class="product-desc">Every engagement starts with a conversation. Based on what we find, we recommend the right scope — from <strong>Signal</strong>, a focused stakeholder and executive interview programme, to <strong>Intelligence</strong>, a full process mining deployment powered by Keystone Intelligence that surfaces how your business actually operates from live system data.</p>
          <ul class="product-capabilities">
            <li>Stakeholder and executive surveys and interviews</li>
            <li>Process mapping and workflow analysis</li>
            <li>AI opportunity identification and prioritisation</li>
            <li>Data and technology readiness assessment</li>
            <li>ROI modelling and business case development</li>
            <li>Process intelligence and mining — recommended where process visibility is a prerequisite</li>
          </ul>
          <div class="product-fit">
            <p class="product-fit-label">Right for you if</p>
            <ul class="product-fit-list">
              <li>Your board wants an AI strategy and you don't have a defensible answer yet</li>
              <li>You want to understand your processes before automating them</li>
              <li>A previous AI pilot stalled and you need to understand why</li>
              <li>Regulatory or operational pressure requires validated process understanding</li>
            </ul>
          </div>
          <a href="/contact/" class="btn btn-outline btn-sm product-cta">Get Started
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </div>

        <!-- Stack Build -->
        <div class="product-card product-card-featured" data-reveal-child>
          <div class="product-card-top">
            <div class="product-icon product-icon-featured" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="product-label">Build</span>
          </div>
          <h3 class="product-name">Stack Build</h3>
          <p class="product-tagline">The execution layer.</p>
          <p class="product-desc">From a focused <strong>Proof of Concept</strong> on real production data to full <strong>Product Development</strong> over months of continuous delivery — we design and build AI tools, products, and systems on a foundation that's already been validated. Everything built is yours. Full IP transfer, senior engineers, no exceptions.</p>
          <ul class="product-capabilities">
            <li>Proof of concept — working AI system on real data, deployed in your environment</li>
            <li>Internal AI tools and workflow automation</li>
            <li>Agentic systems and autonomous process automation</li>
            <li>Customer-facing AI products and features</li>
            <li>Enterprise system integrations — SAP, Salesforce, Microsoft, legacy</li>
            <li>Data infrastructure and MLOps</li>
          </ul>
          <div class="product-fit">
            <p class="product-fit-label">Right for you if</p>
            <ul class="product-fit-list">
              <li>You have a validated AI opportunity and need engineers to execute it</li>
              <li>You need a proof of concept to secure board approval</li>
              <li>Internal AI talent is unavailable or insufficient</li>
              <li>An existing AI initiative has stalled and needs to be rescued</li>
            </ul>
          </div>
          <a href="/contact/" class="btn btn-primary btn-sm product-cta">Get Started
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </div>

        <!-- Stack Scale -->
        <div class="product-card" data-reveal-child>
          <div class="product-card-top">
            <div class="product-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span class="product-label">Scale</span>
          </div>
          <h3 class="product-name">Stack Scale</h3>
          <p class="product-tagline">The adoption layer.</p>
          <p class="product-desc">From an <strong>Executive AI Briefing</strong> that aligns leadership in half a day, to a full <strong>AI Adoption Program</strong> that embeds AI into daily workflows by role and measures adoption at 30, 60, and 90 days. The output is not a certificate — it's a team that demonstrably operates differently.</p>
          <ul class="product-capabilities">
            <li>Executive AI briefing and strategic alignment</li>
            <li>AI Adoption Program — role-specific, hands-on, 90-day measured</li>
            <li>AI Champions — internal advocates built by department</li>
            <li>Custom AI playbooks by role and function</li>
            <li>AI governance and responsible use policy</li>
          </ul>
          <div class="product-fit">
            <p class="product-fit-label">Right for you if</p>
            <ul class="product-fit-list">
              <li>AI tools are deployed but adoption is low</li>
              <li>Leadership lacks alignment on AI strategy or risk</li>
              <li>You need AI embedded in daily workflows, not just demonstrated</li>
              <li>A governance framework is required before you can proceed</li>
            </ul>
          </div>
          <a href="/contact/" class="btn btn-outline btn-sm product-cta">Get Started
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── RESULTS ──────────────────────────────────────────────── -->
  <section class="section section-outcomes">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Real outcomes</div>
        <h2 class="section-title section-title-center">What clients say after we ship.</h2>
      </div>

      <div class="outcomes-row" data-reveal-stagger>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">73%</div>
          <div class="outcomes-stat-label">Reduction in processing time</div>
        </div>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">12wk</div>
          <div class="outcomes-stat-label">Average time to production</div>
        </div>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">$2.1M</div>
          <div class="outcomes-stat-label">Client efficiency gains (annual)</div>
        </div>
      </div>

      <blockquote class="outcomes-testimonial" data-reveal>
        <p>&ldquo;Stack10 turned our AI strategy from a PowerPoint into a production system in under 3 months.&rdquo;</p>
        <footer>
          <strong>Senior Executive</strong> &mdash; Enterprise Financial Services Client
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ── DIFFERENTIATORS ───────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Why Stack10</div>
        <h2 class="section-title section-title-center">Five reasons clients choose us over the alternatives.</h2>
        <p class="section-desc section-desc-center">Not promises. Not frameworks. Reasons grounded in how we're structured, how we price, and what we've committed to delivering.</p>
      </div>
      <div class="diff-list" data-reveal-stagger>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Output pricing, not hours</h4>
            <p class="diff-desc">We charge for story points delivered. Our incentives are aligned with your results — not with keeping the engagement running longer than it needs to be.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Senior engineers. No exceptions.</h4>
            <p class="diff-desc">We don't bait-and-switch. The engineers who scope your engagement are the engineers who build it. No juniors learning on your budget. No bench warmers billing time.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Process truth before AI</h4>
            <p class="diff-desc">We don't build AI on broken processes. Our process intelligence layer — powered by Keystone Intelligence — validates process health before a single line of code is written. No automating dysfunction.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Validated ROI. Not promised.</h4>
            <p class="diff-desc">Post-deployment process mining confirms real impact against your pre-build baseline. We don't claim outcomes — we prove them with data. Dashboards, not decks.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Every engagement proves value in 90 days or less</h4>
            <p class="diff-desc">We're not here to start a multi-year relationship before delivering anything. Every fixed-fee engagement produces a concrete, measurable output in a defined timeframe — then we earn the right to do more.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ────────────────────────────────────────────── -->
  <section class="section section-industries">
    <div class="industry-bg-grid" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Industries</div>
        <h2 class="section-title section-title-center">Deep expertise where it matters.</h2>
      </div>
      <div class="industry-grid" data-reveal-stagger>
        <a href="/industries/financial-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M8 10v11M12 10v11M16 10v11M20 10v11"/></svg>
          </div>
          <h4 class="industry-title">Financial Services</h4>
          <p class="industry-desc">Risk, compliance, operations</p>
        </a>
        <a href="/industries/government/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="industry-title">Government</h4>
          <p class="industry-desc">Sovereign, secure, Australian-built</p>
        </a>
        <a href="/industries/healthcare/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h4 class="industry-title">Healthcare</h4>
          <p class="industry-desc">Hospitals, insurers, aged care</p>
        </a>
        <a href="/industries/professional-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h4 class="industry-title">Professional Services</h4>
          <p class="industry-desc">Law, accounting, consulting</p>
        </a>
        <a href="/industries/manufacturing/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20M6 20V10l4-6v6l4-6v6l4-6v16"/></svg>
          </div>
          <h4 class="industry-title">Manufacturing</h4>
          <p class="industry-desc">SAP, predictive, Industry 4.0</p>
        </a>
        <a href="/industries/logistics/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          </div>
          <h4 class="industry-title">Logistics</h4>
          <p class="industry-desc">Route, demand, warehouse AI</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── TRUST ─────────────────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Trust &amp; Compliance</div>
        <h2 class="section-title section-title-center">Enterprise-grade security built into every engagement.</h2>
      </div>
      <div class="trust-grid" data-reveal-stagger>
