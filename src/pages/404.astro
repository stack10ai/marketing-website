---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Stack10"
  description="The page you're looking for doesn't exist."
>

  <section class="not-found-section">
    <div class="not-found-inner">
      <div class="not-found-code" aria-hidden="true">404</div>
      <div class="section-label">Page not found</div>
      <h1 class="not-found-title">This page doesn't exist.</h1>
      <p class="not-found-desc">
        The link you followed may be broken, or the page may have been moved.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary btn-lg">
          Back to homepage
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <a href="/contact/" class="btn btn-outline btn-lg">Contact us</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .not-found-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-20) var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .not-found-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(0.760 0.210 150 / 0.12) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 30%, transparent 100%);
  }

  .not-found-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 560px;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: var(--weight-800);
    line-height: 1;
    color: oklch(0.760 0.210 150 / 0.12);
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
    user-select: none;
  }

  .not-found-section .section-label {
    margin: 0 auto var(--space-4);
  }

  .not-found-title {
    font-size: var(--size-3xl);
    font-weight: var(--weight-700);
    color: var(--foreground);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .not-found-desc {
    font-size: var(--size-lg);
    color: var(--muted-foreground);
    line-height: 1.6;
    margin-bottom: var(--space-10);
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
