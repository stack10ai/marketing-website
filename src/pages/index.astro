---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
---

<BaseLayout
  title="Stack10 — Enterprise AI Transformation | Strategy to Production"
  description="Stack10 designs, builds, and deploys production AI systems for Australian mid-market enterprises — measured in story points and validated ROI, not strategy slides."
  canonicalUrl="https://stack10.ai/"
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero hero-split">
    <div class="hero-dot-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="section-label hero-eyebrow">Enterprise AI Transformation · Australia</div>
      <h1 class="hero-title hero-title-left">
        Your Trusted AI Transformation&nbsp;Partner
      </h1>
      <p class="hero-subtitle hero-subtitle-left">
        We help enterprises set and execute their AI strategy across their products, processes, and people.
      </p>
      <div class="hero-actions hero-actions-left">
        <a href="/contact/" class="btn btn-primary btn-lg">
          Get Started
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <a href="/how-we-work/" class="btn btn-outline btn-lg">See Our Approach</a>
      </div>
      <p class="hero-microcopy">Fixed-fee engagements &middot; Senior engineers only &middot; No retainer lock-in</p>
    </div>
    <div class="hero-visual-col">
      <HeroVisual />
    </div>
  </section>

  <!-- ── PROBLEM ───────────────────────────────────────────────── -->
  <section class="section section-problem">
    <div class="problem-blocks" aria-hidden="true">
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-lavender" data-row="1" data-zone="left"  style="width:240px"></span>
          <span class="bk bk-peach"    data-row="1" data-zone="left"  style="width:90px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-mint"     data-row="1" data-zone="right" style="width:200px"></span>
          <span class="bk bk-sand"     data-row="1" data-zone="right" style="width:110px"></span>
          <span class="bk bk-cream"    data-row="1" data-zone="right" style="width:70px"></span>
        </div>
      </div>
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-solid-dark" data-row="2" data-zone="left"  style="width:180px"></span>
          <span class="bk bk-cream"      data-row="2" data-zone="left"  style="width:130px"></span>
          <span class="bk bk-pale"       data-row="2" data-zone="left"  style="width:60px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-lavender"   data-row="2" data-zone="right" style="width:260px"></span>
          <span class="bk bk-peach"      data-row="2" data-zone="right" style="width:90px"></span>
        </div>
      </div>
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-mint"     data-row="3" data-zone="left"  style="width:280px"></span>
          <span class="bk bk-grey"     data-row="3" data-zone="left"  style="width:50px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-sand"     data-row="3" data-zone="right" style="width:160px"></span>
          <span class="bk bk-pale"     data-row="3" data-zone="right" style="width:120px"></span>
          <span class="bk bk-lavender" data-row="3" data-zone="right" style="width:60px"></span>
        </div>
      </div>
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-peach"    data-row="4" data-zone="left"  style="width:170px"></span>
          <span class="bk bk-mint"     data-row="4" data-zone="left"  style="width:100px"></span>
          <span class="bk bk-cream"    data-row="4" data-zone="left"  style="width:80px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-lavender" data-row="4" data-zone="right" style="width:220px"></span>
          <span class="bk bk-sand"     data-row="4" data-zone="right" style="width:80px"></span>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="problem-split" data-reveal>
        <div class="problem-copy">
          <div class="section-label">The Problem</div>
          <h2 class="section-title">The end of traditional consulting.</h2>
          <div class="gradient-line"></div>
          <p class="p1">In 1926, McKinsey invented traditional management consulting.<br><strong>In 2025, Stack10 is reinventing it.</strong></p>
          <p class="p2">The major firms still sell theoretical roadmaps, multi-year &ldquo;Digital Transformations,&rdquo; and 200-page decks engineered to maximise billable hours, not business value.</p>
          <p class="p2 problem-body-2">The board approves the budget. A senior partner presents the vision. Juniors do the work. Six months later you are left with a strategy deck you can&rsquo;t execute, a pilot stuck in review, and a proposal for the next engagement to fix the first one.</p>
          <p class="p2">And if they do finally ship &mdash; AI will be built on the same broken processes the deck was built on &mdash; it doesn&rsquo;t fix your operations and automates dysfunction at scale.</p>
          <p class="p1 problem-transition">This is why we built Stack10.</p>
        </div>
        <div class="problem-cards" data-reveal-stagger>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;The board approved a $300K AI investment. 12 months later: a strategy deck and a stalled proof-of-concept.&rdquo;</p>
          </div>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;We deployed Copilot company-wide. Nobody uses it. Nobody knows why.&rdquo;</p>
          </div>
          <div class="problem-card" data-reveal-child>
            <div class="problem-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-quote">&ldquo;We automated a process we didn&rsquo;t understand. Now we have a faster version of the same problem.&rdquo;</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SOLUTIONS ─────────────────────────────────────────────── -->
  <section class="section section-solutions">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Our solutions</div>
        <h2 class="section-title section-title-center">Three products. A clear progression.</h2>
        <p class="section-desc section-desc-center">Choose where to start based on where you are. Every engagement is fixed-fee and custom-scoped — no retainers, no ambiguity.</p>
      </div>

      <div class="solutions-grid" data-reveal-stagger>

        <a href="/services/discover/" class="solution-card" data-reveal-child>
          <div class="solution-num">01</div>
          <div class="solution-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <h3 class="solution-name">Stack Discover</h3>
          <p class="solution-tagline">The intelligence layer</p>
          <p class="solution-desc">Surface real AI opportunities from your operational data before a line of code is written.</p>
          <span class="solution-link">
            Explore
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>

        <a href="/services/build/" class="solution-card" data-reveal-child>
          <div class="solution-num">02</div>
          <div class="solution-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="solution-name">Stack Build</h3>
          <p class="solution-tagline">The execution layer</p>
          <p class="solution-desc">Senior AI engineers ship production systems on story points. Full IP transfer. No retainer.</p>
          <span class="solution-link">
            Explore
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>

        <a href="/services/scale/" class="solution-card" data-reveal-child>
          <div class="solution-num">03</div>
          <div class="solution-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="solution-name">Stack Scale</h3>
          <p class="solution-tagline">The scaling layer</p>
          <p class="solution-desc">Embed AI into daily workflows by role. Measured at 30, 60, and 90 days — not slide decks.</p>
          <span class="solution-link">
            Explore
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── CASE STUDIES ─────────────────────────────────────────── -->
  <section class="section section-case-studies">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">Case Studies</div>
        <h2 class="section-title">AI that ships. Results that prove it.</h2>
      </div>

      <div class="case-study-list" data-reveal-stagger>

        <!-- Case Study: Smile Partners -->
        <article class="case-study-card" data-reveal-child>
          <div class="case-study-story">
            <div class="case-study-meta">
              <span class="case-study-industry">Healthcare</span>
              <span class="case-study-sep" aria-hidden="true">·</span>
              <span class="case-study-product">Stack Build</span>
            </div>
            <h3 class="case-study-headline">From manual reporting to instant AI intelligence — across 50 practices and $111M in production</h3>
            <p class="case-study-desc">A PE-backed healthcare group's analytics team was entirely dedicated to pulling reports across 50 practices, 311,000 patient records, and 130 KPIs. Stack10 deployed four interconnected AI systems — a plain-English intelligence layer, an autonomous WHS compliance agent, a cross-entity Xero reconciliation tool, and an automated procurement workflow. Leaders now get answers in seconds. Quarterly compliance work dropped from 80 hours to under one.</p>
            <div class="case-study-footer">
              <span class="case-study-client">PE-backed Healthcare Group</span>
              <a href="/case-studies/smile-partners/" class="case-study-link">
                Read case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            </div>
          </div>
          <div class="case-study-outcome" data-count-up>
            <div class="case-study-metric">
              <span class="case-study-metric-value" data-count-up-value>98%</span>
              <span class="case-study-metric-label">reduction in compliance processing time</span>
            </div>
            <div class="case-study-metric">
              <span class="case-study-metric-value" data-count-up-value>50</span>
              <span class="case-study-metric-label">practices connected across 8 states</span>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ── DIFFERENTIATORS ───────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Why Stack10</div>
        <h2 class="section-title section-title-center">Five reasons clients choose us over the alternatives.</h2>
        <p class="section-desc section-desc-center">Not promises. Not frameworks. Reasons grounded in how we're structured, how we price, and what we've committed to delivering.</p>
      </div>
      <div class="diff-list" data-reveal-stagger>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Output pricing, not hours</h4>
            <p class="diff-desc">We charge for story points delivered. Our incentives are aligned with your results — not with keeping the engagement running longer than it needs to be.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Senior engineers. No exceptions.</h4>
            <p class="diff-desc">We don't bait-and-switch. The engineers who scope your engagement are the engineers who build it. No juniors learning on your budget. No bench warmers billing time.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Process truth before AI</h4>
            <p class="diff-desc">We don't build AI on broken processes. Our process intelligence layer — powered by Keystone Intelligence — validates process health before a single line of code is written. No automating dysfunction.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Validated ROI. Not promised.</h4>
            <p class="diff-desc">Post-deployment process mining confirms real impact against your pre-build baseline. We don't claim outcomes — we prove them with data. Dashboards, not decks.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Every engagement proves value in 90 days or less</h4>
            <p class="diff-desc">We're not here to start a multi-year relationship before delivering anything. Every fixed-fee engagement produces a concrete, measurable output in a defined timeframe — then we earn the right to do more.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ────────────────────────────────────────────── -->
  <section class="section section-industries">
    <div class="industry-bg-grid" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Industries</div>
        <h2 class="section-title section-title-center">Deep expertise where it matters.</h2>
      </div>
      <div class="industry-grid" data-reveal-stagger>
        <a href="/industries/financial-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M8 10v11M12 10v11M16 10v11M20 10v11"/></svg>
          </div>
          <h4 class="industry-title">Financial Services</h4>
          <p class="industry-desc">Risk, compliance, operations</p>
        </a>
        <a href="/industries/government/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="industry-title">Government</h4>
          <p class="industry-desc">Sovereign, secure, Australian-built</p>
        </a>
        <a href="/industries/healthcare/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h4 class="industry-title">Healthcare</h4>
          <p class="industry-desc">Hospitals, insurers, aged care</p>
        </a>
        <a href="/industries/professional-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h4 class="industry-title">Professional Services</h4>
          <p class="industry-desc">Law, accounting, consulting</p>
        </a>
        <a href="/industries/manufacturing/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20M6 20V10l4-6v6l4-6v6l4-6v16"/></svg>
          </div>
          <h4 class="industry-title">Manufacturing</h4>
          <p class="industry-desc">SAP, predictive, Industry 4.0</p>
        </a>
        <a href="/industries/logistics/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          </div>
          <h4 class="industry-title">Logistics</h4>
          <p class="industry-desc">Route, demand, warehouse AI</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── COMMITMENTS ─────────────────────────────────────────── -->
  <section class="section section-commitments">
    <div class="commitments-bg-grid" aria-hidden="true"></div>
    <div class="commitments-blocks" aria-hidden="true">
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-mint"        data-row="1" data-zone="left"  style="width:220px"></span>
          <span class="bk bk-lavender"    data-row="1" data-zone="left"  style="width:80px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-peach"       data-row="1" data-zone="right" style="width:160px"></span>
          <span class="bk bk-cream"       data-row="1" data-zone="right" style="width:110px"></span>
        </div>
      </div>
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-solid-green" data-row="2" data-zone="left"  style="width:280px"></span>
          <span class="bk bk-sand"        data-row="2" data-zone="left"  style="width:70px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-pale"        data-row="2" data-zone="right" style="width:180px"></span>
          <span class="bk bk-grey"        data-row="2" data-zone="right" style="width:130px"></span>
        </div>
      </div>
      <div class="blocks-row">
        <div class="bk-group">
          <span class="bk bk-lavender"    data-row="3" data-zone="left"  style="width:200px"></span>
          <span class="bk bk-peach"       data-row="3" data-zone="left"  style="width:80px"></span>
        </div>
        <div class="bk-group">
          <span class="bk bk-mint"        data-row="3" data-zone="right" style="width:150px"></span>
          <span class="bk bk-cream"       data-row="3" data-zone="right" style="width:160px"></span>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">How we protect you</div>
        <h2 class="section-title">Data misuse. Vendor lock-in. Broken processes. Unproven tools. These are the silent killers of AI investment.</h2>
        <p class="section-desc">We've built our entire engagement model around preventing them.</p>
      </div>
      <div class="commitments-grid" data-reveal-stagger>

        <div class="card commitment-card" data-reveal-child>
          <div class="commitment-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="commitment-title">We read the terms. You shouldn't have to.</h4>
          <p class="commitment-desc">Every major AI platform has data training clauses most businesses never see. We check every integration so your data doesn't feed someone else's model.</p>
        </div>

        <div class="card commitment-card" data-reveal-child>
          <div class="commitment-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h4 class="commitment-title">When we leave, so does our invoice. Nothing else.</h4>
          <p class="commitment-desc">Everything we custom-build is yours — code, models, documentation. No lock-in, no ongoing fees.</p>
        </div>

        <div class="card commitment-card" data-reveal-child>
          <div class="commitment-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h4 class="commitment-title">We don't automate broken processes.</h4>
          <p class="commitment-desc">AI built on a flawed process doesn't fix the problem — it accelerates it. We validate what's underneath before we write a line of code.</p>
        </div>

        <div class="card commitment-card" data-reveal-child>
          <div class="commitment-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h4 class="commitment-title">We use what we recommend.</h4>
