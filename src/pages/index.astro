---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
---

<BaseLayout
  title="Stack10 — Enterprise AI Transformation | Strategy to Production"
  description="Stack10 delivers enterprise AI transformation measured in production, not promises. Fixed-price discovery, process intelligence, and output-based engineering."
  canonicalUrl="https://stack10.ai/"
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero hero-split">
    <div class="hero-dot-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="section-label">Enterprise AI Consulting</div>
      <h1 class="hero-title hero-title-left">
        AI transformation measured in production,&nbsp;not&nbsp;promises.
      </h1>
      <p class="hero-subtitle hero-subtitle-left">
        We help financial services, private equity, and government organisations ship AI into production — with a clear plan, measurable outcomes, and ongoing operational support.
      </p>
      <div class="hero-actions hero-actions-left">
        <a href="/get-started/" class="btn btn-primary btn-lg">
          Get Started
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <a href="/how-we-work/" class="btn btn-outline btn-lg">See Our Approach</a>
      </div>
    </div>
    <div class="hero-visual-col">
      <HeroVisual />
    </div>
  </section>

  <!-- ── LOGO BAR ──────────────────────────────────────────────── -->
  <div class="logo-bar">
    <div class="logo-bar-label">Trusted by enterprises across financial services and government</div>
    <div class="logo-bar-grid">
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
      <div class="logo-bar-item" aria-hidden="true">
        <img src="/logo-light.svg" alt="" class="logo-bar-logo logo-light" />
        <img src="/logo-dark.svg" alt="" class="logo-bar-logo logo-dark" />
      </div>
    </div>
  </div>

  <!-- ── STATS ─────────────────────────────────────────────────── -->
  <section class="section section-stats section-with-accents">
    <div class="floating-accents" aria-hidden="true">
      <div class="accent-block accent-a1"></div>
      <div class="accent-block accent-a2"></div>
      <div class="accent-block accent-a3"></div>
      <div class="accent-block accent-a4"></div>
      <div class="accent-block accent-a5"></div>
      <div class="accent-block accent-a6"></div>
      <div class="accent-block accent-a7"></div>
      <div class="accent-block accent-a8"></div>
      <div class="accent-block accent-a9"></div>
      <div class="accent-block accent-a10"></div>
    </div>
    <div class="container">
      <div class="stat-bar-dark" data-reveal-stagger>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">87%</div>
          <div class="stat-label">of AI initiatives never reach production</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">18mo</div>
          <div class="stat-label">Average pilot to production (industry)</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">12wk</div>
          <div class="stat-label">Stack10 average: strategy to production</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">73%</div>
          <div class="stat-label">Reduction in processing time (clients)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES — two product families ────────────────────── -->
  <section class="section section-services">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">What we do</div>
        <h2 class="section-title section-title-center">Two product families. One outcome: AI in production.</h2>
      </div>

      <div class="services-duo" data-reveal-stagger>
        <div class="services-duo-card" data-reveal-child>
          <div class="services-duo-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2L18 6V14L10 18L2 14V6L10 2Z" stroke-linejoin="round"/><path d="M10 18V10"/><path d="M18 6L10 10L2 6"/></svg>
          </div>
          <h3 class="services-duo-title">AI Roadmap & Engineering</h3>
          <ul class="services-duo-list">
            <li>AI opportunity assessment & ROI ranking</li>
            <li>Working prototypes on your real data</li>
            <li>Production deployment & continuous delivery</li>
          </ul>
        </div>
        <div class="services-duo-card" data-reveal-child>
          <div class="services-duo-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3 class="services-duo-title">Process Intelligence</h3>
          <ul class="services-duo-list">
            <li>Process mining & bottleneck analysis</li>
            <li>End-to-end organisational process mapping</li>
            <li>Post-deployment impact measurement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE STACK10 APPROACH — horizontal timeline ────────────── -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">The Stack10 Approach</div>
        <h2 class="section-title section-title-center">From discovery to production in weeks, not years.</h2>
        <p class="section-desc section-desc-center">Five standalone products. Choose what you need — start anywhere.</p>
      </div>

      <div class="timeline" data-reveal>
        <div class="timeline-steps">
          <div class="timeline-step">
            <div class="timeline-dot">1</div>
            <h3 class="timeline-title">Stack Discover</h3>
            <p class="timeline-desc">Find your highest-value AI opportunities in 2 weeks.</p>
            <div class="timeline-meta">2 weeks &middot; $25K</div>
          </div>
          <div class="timeline-step">
            <div class="timeline-dot">2</div>
            <h3 class="timeline-title">Stack Audit</h3>
            <p class="timeline-desc">Deep-dive: process mining, prototype, production roadmap.</p>
            <div class="timeline-meta">6-8 weeks &middot; $75K</div>
          </div>
          <div class="timeline-step">
            <div class="timeline-dot">3</div>
            <h3 class="timeline-title">Stack One</h3>
            <p class="timeline-desc">Dedicated AI engineering capacity embedded in your org.</p>
            <div class="timeline-meta">Ongoing &middot; $50K/mo</div>
          </div>
          <div class="timeline-step">
            <div class="timeline-dot">4</div>
            <h3 class="timeline-title">Stack Map</h3>
            <p class="timeline-desc">Rapid process mining to implement a specific tool or solution.</p>
            <div class="timeline-meta">1 month &middot; $25K</div>
          </div>
          <div class="timeline-step">
            <div class="timeline-dot">5</div>
            <h3 class="timeline-title">Stack E2E</h3>
            <p class="timeline-desc">End-to-end process map across every function and workflow.</p>
            <div class="timeline-meta">Custom scope</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RESULTS ──────────────────────────────────────────────── -->
  <section class="section section-outcomes">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Real outcomes</div>
        <h2 class="section-title section-title-center">Real results from real operations.</h2>
      </div>

      <div class="outcomes-row" data-reveal-stagger>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">73%</div>
          <div class="outcomes-stat-label">Reduction in processing time</div>
        </div>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">12wk</div>
          <div class="outcomes-stat-label">Average time to production</div>
        </div>
        <div class="outcomes-stat" data-reveal-child>
          <div class="outcomes-stat-value">$2.1M</div>
          <div class="outcomes-stat-label">Client efficiency gains (annual)</div>
        </div>
      </div>

      <blockquote class="outcomes-testimonial" data-reveal>
        <p>&ldquo;Stack10 turned our AI strategy from a PowerPoint into a production system in under 3 months.&rdquo;</p>
        <footer>
          <strong>Senior Executive</strong> &mdash; Enterprise Financial Services Client
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ── DIFFERENTIATORS — green bar markers, NOT cards ────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Built differently</div>
        <h2 class="section-title section-title-center">Every engagement ends with working software in production.</h2>
        <p class="section-desc section-desc-center">Zero slide decks. Zero theoretical frameworks. Real systems, real outcomes, real accountability.</p>
      </div>
      <div class="diff-list" data-reveal-stagger>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Built for regulated industries</h4>
            <p class="diff-desc">Financial services, government, private equity, healthcare — we understand compliance, governance, and the stakes of getting it wrong.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Output-based, not time-based</h4>
            <p class="diff-desc">You pay for outcomes delivered, not hours billed. No bench warmers, no time-and-materials surprises.</p>
          </div>
        </div>
        <div class="diff-item" data-reveal-child>
          <div class="diff-bar" aria-hidden="true"></div>
          <div>
            <h4 class="diff-title">Weeks, not months</h4>
            <p class="diff-desc">We deliver production systems in the time it takes traditional consultants to schedule a workshop.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES — compact cards ─────────────────────────────── -->
  <section class="section section-industries">
    <div class="industry-bg-grid" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Industries</div>
        <h2 class="section-title section-title-center">Deep expertise where it matters.</h2>
      </div>
      <div class="industry-grid" data-reveal-stagger>
        <a href="/industries/financial-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M8 10v11M12 10v11M16 10v11M20 10v11"/></svg>
          </div>
          <h4 class="industry-title">Financial Services</h4>
          <p class="industry-desc">Risk, compliance, operations</p>
        </a>
        <a href="/industries/government/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="industry-title">Government</h4>
          <p class="industry-desc">Sovereign, secure, Australian-built</p>
        </a>
        <a href="/industries/healthcare/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h4 class="industry-title">Healthcare</h4>
          <p class="industry-desc">Hospitals, insurers, aged care</p>
        </a>
        <a href="/industries/professional-services/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h4 class="industry-title">Professional Services</h4>
          <p class="industry-desc">Law, accounting, consulting</p>
        </a>
        <a href="/industries/manufacturing/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20M6 20V10l4-6v6l4-6v6l4-6v16"/></svg>
          </div>
          <h4 class="industry-title">Manufacturing</h4>
          <p class="industry-desc">SAP, predictive, Industry 4.0</p>
        </a>
        <a href="/industries/logistics/" class="industry-card" data-reveal-child>
          <div class="industry-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          </div>
          <h4 class="industry-title">Logistics</h4>
          <p class="industry-desc">Route, demand, warehouse AI</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── TRUST — with icons ─────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Trust & Compliance</div>
        <h2 class="section-title section-title-center">Enterprise-grade security built into every engagement.</h2>
      </div>
      <div class="trust-grid" data-reveal-stagger>
        <div class="trust-item" data-reveal-child>
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <div class="trust-label">SOC 2 Type II</div>
          <div class="trust-desc">Audited controls for security, availability, and confidentiality</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="trust-label">ISO 27001</div>
          <div class="trust-desc">Information security management system certification</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          </div>
          <div class="trust-label">Australian Sovereign</div>
          <div class="trust-desc">Data stays in Australia. Team in Perth & Sydney.</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/><circle cx="12" cy="16" r="1"/></svg>
          </div>
          <div class="trust-label">IRAP Assessed</div>
          <div class="trust-desc">Government-grade security for sensitive workloads</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA — soft green background ──────────────────────────── -->
  <section class="cta-section cta-soft section-with-accents" data-reveal>
    <div class="floating-accents" aria-hidden="true">
      <div class="accent-block accent-c1"></div>
      <div class="accent-block accent-c2"></div>
      <div class="accent-block accent-c3"></div>
      <div class="accent-block accent-c4"></div>
      <div class="accent-block accent-c5"></div>
      <div class="accent-block accent-c6"></div>
      <div class="accent-block accent-c7"></div>
      <div class="accent-block accent-c8"></div>
      <div class="accent-block accent-c9"></div>
      <div class="accent-block accent-c10"></div>
      <div class="accent-block accent-c11"></div>
      <div class="accent-block accent-c12"></div>
      <div class="accent-block accent-c13"></div>
      <div class="accent-block accent-c14"></div>
    </div>
    <div class="section-label">Contact Us</div>
    <h2 class="cta-title">Ready to move AI from pilot to production?</h2>
    <p class="cta-desc">Book a free discovery call. We'll assess your AI readiness and identify your highest-value opportunities.</p>
    <div class="cta-actions">
      <a href="/get-started/" class="btn btn-primary btn-lg cta-btn-dark">
        Get Started
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
      <a href="mailto:hello@stack10.ai" class="btn btn-outline btn-lg">Email Us</a>
    </div>
    <p class="caption cta-footnote-green">Or email us at hello@stack10.ai</p>
  </section>

</BaseLayout>

<style>
  /* ── Hero — clean white with dot grid + split layout ─────── */
  .hero { background: var(--background); }

  .hero-split {
    min-height: 70vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-20);
    max-width: var(--container-max, 81rem);
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
    text-align: left;
    position: relative;
    overflow: hidden;
  }

  .hero-dot-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(oklch(0.760 0.210 150 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.760 0.210 150 / 0.12) 1px, transparent 1px),
      radial-gradient(circle, oklch(0.760 0.210 150 / 0.22) 1px, transparent 1px);
    background-size: 64px 64px, 64px 64px, 32px 32px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 80% at 60% 50%, black 40%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-visual-col {
    position: relative;
    z-index: 1;
    padding: var(--space-8) 0;
  }

  /* Hero label spacing */
  .hero-content .section-label {
    margin-bottom: var(--space-6);
  }

  .hero-title-left {
    text-align: left;
    max-width: 600px;
    margin-bottom: var(--space-6);
  }

  .hero-subtitle-left {
    text-align: left;
    margin-bottom: var(--space-10);
  }

  .hero-actions-left {
    justify-content: flex-start;
  }

  .hero-actions .btn-outline {
    background-color: var(--background);
  }

  /* Button arrow alignment */
  .btn svg {
    flex-shrink: 0;
    vertical-align: middle;
  }

  @media (max-width: 1023px) {
    .hero-split {
      grid-template-columns: 1fr;
      text-align: center;
      padding: var(--space-12) var(--space-6);
      min-height: auto;
    }
    .hero-content .section-label { text-align: center; }
    .hero-title-left,
    .hero-subtitle-left { text-align: center; max-width: 100%; }
    .hero-actions-left { justify-content: center; }
    .hero-visual-col { display: none; }
    .hero-dot-grid { mask-image: none; }
  }

  @media (max-width: 480px) {
    .hero-title-left {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
  }

  /* ── Section variants ──────────────────────────────────────── */
  .section-dark {
    background: var(--gray-950);
    color: var(--gray-50);
  }

  .section-dark .section-label { color: var(--green-400); }
  .section-dark .section-title { color: var(--gray-50); }
  .section-dark .section-desc { color: var(--gray-400); }

  .section-muted { background: var(--muted); }

  .section-header-center { text-align: center; }

  .section-title-center {
    margin-left: auto;
    margin-right: auto;
    max-width: 800px;
  }

  .section-desc-center {
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Services — duo cards ──────────────────────────────────── */
  .services-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  @media (max-width: 767px) {
    .services-duo { grid-template-columns: 1fr; }
  }

  .services-duo-card {
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
  }

  .services-duo-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--green-50);
    border-radius: var(--radius-lg);
    color: var(--primary-text);
    margin-bottom: var(--space-4);
  }

  .services-duo-title {
    font-size: var(--text-h5);
    font-weight: var(--weight-600);
    color: var(--foreground);
    margin-bottom: var(--space-5);
  }

  .services-duo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .services-duo-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-p2);
