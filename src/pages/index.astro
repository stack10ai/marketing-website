<script>
  // Block stacking animation — scroll-triggered, never leaves blank state
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function initBlocks(containerSelector) {
      const container = document.querySelector(containerSelector);
      if (!container) return;

      const allBlocks = Array.from(container.querySelectorAll('.bk'));
      if (!allBlocks.length) return;

      const byRow = {};
      allBlocks.forEach(block => {
        const row  = block.dataset.row;
        const zone = block.dataset.zone;
        if (!byRow[row]) byRow[row] = { left: [], right: [] };
        if (byRow[row][zone]) byRow[row][zone].push(block);
      });

      function showBlock(b) { b.style.transform = 'scaleX(1)'; b.style.opacity = '1'; }
      function hideBlock(b) { b.style.transform = 'scaleX(0)'; b.style.opacity = '0'; }

      function buildSelection() {
        const selected = new Set();
        Object.values(byRow).forEach(({ left, right }) => {
          left.forEach(b  => { if (Math.random() < 0.75) selected.add(b); });
          right.forEach(b => { if (Math.random() < 0.75) selected.add(b); });
          // Always anchor at least one block per side — never an empty side
          if (!left.some(b  => selected.has(b)) && left.length)  selected.add(left[0]);
          if (!right.some(b => selected.has(b)) && right.length) selected.add(right[0]);
        });
        return [...selected].sort((a, b) => allBlocks.indexOf(a) - allBlocks.indexOf(b));
      }

      function runCycle(currentVisible, fast) {
        const selected = buildSelection();
        // First run: fast stagger (80ms) so blocks appear immediately on scroll-in
        // Subsequent runs: natural stagger (280–430ms) for a relaxed cycling feel
        const stagger = fast ? 80 : Math.random() * 150 + 280;
        selected.forEach((block, i) => setTimeout(() => showBlock(block), i * stagger));

        // Overlap: fade old cycle out while new blocks are already wiping in
        // The 600ms gap prevents a fully-blank frame between cycles
        const holdTime = selected.length * stagger + Math.random() * 3000 + 2500;
        setTimeout(() => {
          if (currentVisible) currentVisible.forEach(b => hideBlock(b));
          setTimeout(() => runCycle(selected, false), 600);
        }, holdTime);
      }

      // Fire only when the container enters the viewport
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          runCycle(null, true); // fast=true: fills in immediately, no blank delay
          observer.disconnect();
        }
      }, { threshold: 0.25 });

      observer.observe(container);
    }

    initBlocks('.commitments-blocks');
    initBlocks('.problem-blocks');
  })();

</script>

