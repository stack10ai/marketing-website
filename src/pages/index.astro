---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
---

<BaseLayout
  title="Stack10 — Enterprise AI Transformation | Strategy to Production"
  description="Stack10 delivers enterprise AI transformation measured in production, not promises. Fixed-price discovery, process intelligence, and output-based engineering."
  canonicalUrl="https://stack10.ai/"
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero hero-split">
    <div class="hero-dot-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 class="hero-title hero-title-left">
        AI transformation measured in production,&nbsp;not&nbsp;promises.
      </h1>
      <p class="hero-subtitle hero-subtitle-left">
        We help financial services, private equity, and government organisations ship AI into production — with a clear plan, measurable outcomes, and ongoing operational support.
      </p>
      <div class="hero-actions hero-actions-left">
        <a href="/get-started/" class="btn btn-primary btn-lg">Get Started &nearr;</a>
        <a href="/how-we-work/" class="btn btn-outline btn-lg">See Our Approach &rarr;</a>
      </div>
    </div>
    <div class="hero-visual-col">
      <HeroVisual />
    </div>
  </section>

  <!-- ── LOGO BAR ──────────────────────────────────────────────── -->
  <div class="logo-bar">
    <div class="logo-bar-label">Trusted by enterprises across financial services and government</div>
    <div class="logo-bar-grid">
      <div class="logo-bar-item logo-placeholder" style="width:100px;"></div>
      <div class="logo-bar-item logo-placeholder" style="width:120px;"></div>
      <div class="logo-bar-item logo-placeholder" style="width:90px;"></div>
      <div class="logo-bar-item logo-placeholder" style="width:110px;"></div>
      <div class="logo-bar-item logo-placeholder" style="width:100px;"></div>
    </div>
  </div>

  <!-- ── STATS ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="stat-bar-dark" data-reveal-stagger>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">87%</div>
          <div class="stat-label">of AI initiatives never reach production</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">18mo</div>
          <div class="stat-label">Average pilot to production (industry)</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">12wk</div>
          <div class="stat-label">Stack10 average: strategy to production</div>
        </div>
        <div class="stat-item" data-reveal-child>
          <div class="stat-value">73%</div>
          <div class="stat-label">Reduction in processing time (clients)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE STACK10 APPROACH ──────────────────────────────────── -->
  <section class="section section-green">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label muted-label">The Stack10 Approach</div>
        <h2 class="section-title muted-title">From discovery to production in weeks, not years.</h2>
        <p class="section-desc muted-desc">Five standalone products. Choose what you need — start anywhere.</p>
      </div>
      <div class="timeline" data-reveal-stagger>
        <div class="timeline-step" data-reveal-child>
          <div class="timeline-number">1</div>
          <div class="timeline-title muted-title">Stack Discover</div>
          <div class="timeline-desc muted-desc">Find your highest-value AI opportunities in 2 weeks. Structured assessment, ROI-ranked roadmap, executive-ready business cases.</div>
        </div>
        <div class="timeline-step" data-reveal-child>
          <div class="timeline-number">2</div>
          <div class="timeline-title muted-title">Stack Audit</div>
          <div class="timeline-desc muted-desc">Deep-dive into your top AI opportunity. Process mining, working prototype, production-ready roadmap.</div>
        </div>
        <div class="timeline-step" data-reveal-child>
          <div class="timeline-number">3</div>
          <div class="timeline-title muted-title">Stack One</div>
          <div class="timeline-desc muted-desc">Dedicated AI engineering capacity embedded in your org. Output-based delivery of AI projects, continuously.</div>
        </div>
        <div class="timeline-step" data-reveal-child>
          <div class="timeline-number">4</div>
          <div class="timeline-title muted-title">Stack Map</div>
          <div class="timeline-desc muted-desc">Process intelligence quickstart. Rapid process mining focused on implementing a specific tool or solution.</div>
        </div>
        <div class="timeline-step" data-reveal-child>
          <div class="timeline-number">5</div>
          <div class="timeline-title muted-title">Stack E2E</div>
          <div class="timeline-desc muted-desc">End-to-end organisational process map. Complete visibility across every function, every workflow, every handoff.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">Everything you need</div>
        <h2 class="section-title">Two product families. One clear path.</h2>
      </div>

      <div class="feature-grid feature-grid-2 services-intro" data-reveal-stagger>
        <div class="card card-mint feature-card" data-reveal-child>
          <div class="eyebrow card-text-muted">AI Roadmap &amp; Engineering</div>
          <h3 class="feature-title">From "where do we start?" to production AI.</h3>
          <p class="feature-desc card-text-muted">Our AI products take you from opportunity identification to production systems.</p>
          <ul class="feature-checklist">
            <li>Map your AI landscape, rank by ROI</li>
            <li>Validate with process mining + working prototype</li>
            <li>Ship continuously with embedded AI engineers</li>
          </ul>
        </div>
        <div class="card card-lavender feature-card" data-reveal-child>
          <div class="eyebrow card-text-muted">Process Intelligence</div>
          <h3 class="feature-title">See every process. Fix what matters.</h3>
          <p class="feature-desc card-text-muted">Complete visibility — from a single workflow to your entire organisation.</p>
          <ul class="feature-checklist">
            <li>Quickstart: mine one process, implement a tool</li>
            <li>Full org: every function, every workflow, every handoff</li>
          </ul>
        </div>
      </div>

      <div class="feature-grid feature-grid-3" data-reveal-stagger>
        <a href="/services/stack-discover/" class="card card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Stack Discover</h4>
          <p class="feature-desc">AI opportunity assessment, prioritised roadmap with ROI, executive-ready business cases.</p>
          <div class="feature-cta">2 weeks &middot; Fixed price &rarr;</div>
        </a>
        <a href="/services/stack-audit/" class="card card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Stack Audit</h4>
          <p class="feature-desc">Process mining analysis, working AI prototype, production roadmap.</p>
          <div class="feature-cta">4–6 weeks &middot; Fixed price &rarr;</div>
        </a>
        <a href="/services/stack-one/" class="card card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Stack One</h4>
          <p class="feature-desc">Dedicated AI engineering team, output-based delivery, continuous deployment.</p>
          <div class="feature-cta">Ongoing &middot; Per story point &rarr;</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── RESULTS + TESTIMONIAL ─────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">Real outcomes</div>
        <h2 class="section-title">Real results from real operations.</h2>
      </div>
      <div class="results-layout">
        <div class="results-stats" data-reveal-stagger>
          <div class="result-item" data-reveal-child>
            <div class="stat-value">73%</div>
            <div class="stat-label">Reduction in manual processing time</div>
          </div>
          <div class="result-item" data-reveal-child>
            <div class="stat-value">12wk</div>
            <div class="stat-label">Average time to production</div>
          </div>
          <div class="result-item" data-reveal-child>
            <div class="stat-value">$2.1M</div>
            <div class="stat-label">Client efficiency gains (annual)</div>
          </div>
        </div>
        <div data-reveal>
          <div class="testimonial">
            <p class="testimonial-quote">"Stack10 turned our AI strategy from a PowerPoint into a production system in under 3 months."</p>
            <div class="testimonial-author">Senior Executive</div>
            <div class="testimonial-role">Enterprise Financial Services Client</div>
          </div>
          <a href="/customers/" class="btn btn-link" style="margin-top: var(--space-6); display: inline-flex;">Read customer stories &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── DIFFERENTIATORS ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">Built differently</div>
        <h2 class="section-title">Every engagement ends with working software in production.</h2>
        <p class="section-desc">Zero slide decks. Zero theoretical frameworks. Real systems, real outcomes, real accountability.</p>
      </div>
      <div class="feature-grid feature-grid-3" data-reveal-stagger>
        <div class="card card-sand feature-card" data-reveal-child>
          <h4 class="feature-title">Built for regulated industries</h4>
          <p class="feature-desc card-text-muted">Financial services, government, private equity, healthcare — we understand compliance, governance, and the stakes of getting it wrong.</p>
        </div>
        <div class="card card-peach feature-card" data-reveal-child>
          <h4 class="feature-title">Output-based, not time-based</h4>
          <p class="feature-desc card-text-muted">You pay for outcomes delivered, not hours billed. No bench warmers, no time-and-materials surprises.</p>
        </div>
        <div class="card card-cream feature-card" data-reveal-child>
          <h4 class="feature-title">Weeks, not months</h4>
          <p class="feature-desc card-text-muted">We deliver production systems in the time it takes traditional consultants to schedule a workshop.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ────────────────────────────────────────────── -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-header" data-reveal>
        <div class="section-label">Industries</div>
        <h2 class="section-title">Deep expertise where it matters.</h2>
      </div>
      <div class="feature-grid feature-grid-4" data-reveal-stagger>
        <a href="/industries/financial-services/" class="card card-mint card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Financial Services</h4>
          <p class="feature-desc card-text-muted">Risk, compliance, operations</p>
        </a>
        <a href="/industries/government/" class="card card-lavender card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Government</h4>
          <p class="feature-desc card-text-muted">Sovereign, secure, Australian-built</p>
        </a>
        <a href="/industries/healthcare/" class="card card-sand card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Healthcare</h4>
          <p class="feature-desc card-text-muted">Hospitals, insurers, aged care</p>
        </a>
        <a href="/industries/manufacturing/" class="card card-peach card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Manufacturing</h4>
          <p class="feature-desc card-text-muted">SAP, predictive, Industry 4.0</p>
        </a>
        <a href="/industries/professional-services/" class="card card-cream card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Professional Services</h4>
          <p class="feature-desc card-text-muted">Law, accounting, consulting</p>
        </a>
        <a href="/industries/retail/" class="card card-green card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Retail</h4>
          <p class="feature-desc card-text-muted">Omnichannel, supply chain</p>
        </a>
        <a href="/industries/logistics/" class="card card-mint card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Logistics</h4>
          <p class="feature-desc card-text-muted">Route, demand, warehouse AI</p>
        </a>
        <a href="/industries/media-entertainment/" class="card card-lavender card-clickable feature-card" data-reveal-child>
          <h4 class="feature-title">Media &amp; Entertainment</h4>
          <p class="feature-desc card-text-muted">Content, audience, production</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── TRUST ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header-center" data-reveal>
        <div class="section-label">Trust &amp; Compliance</div>
        <h2 class="section-title">Enterprise-grade security built into every engagement.</h2>
      </div>
      <div class="trust-grid" data-reveal-stagger>
        <div class="trust-item" data-reveal-child>
          <div class="trust-label">SOC 2 Type II</div>
          <div class="trust-desc">Audited controls for security, availability, and confidentiality</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-label">ISO 27001</div>
          <div class="trust-desc">Information security management system certification</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-label">Australian Sovereign</div>
          <div class="trust-desc">Data stays in Australia. Team in Perth &amp; Sydney.</div>
        </div>
        <div class="trust-item" data-reveal-child>
          <div class="trust-label">IRAP Assessed</div>
          <div class="trust-desc">Government-grade security for sensitive workloads</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="cta-section" data-reveal>
    <h2 class="cta-title">Ready to move AI from pilot to production?</h2>
    <p class="cta-desc">Book a free discovery call. We'll assess your AI readiness and identify your highest-value opportunities.</p>
    <div class="cta-actions">
      <a href="/get-started/" class="btn btn-primary btn-lg">Get Started &nearr;</a>
      <a href="mailto:hello@stack10.ai" class="btn btn-outline btn-lg cta-email-btn">Email Us</a>
    </div>
    <p class="caption cta-footnote">Or email us at hello@stack10.ai</p>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero { background: var(--card-cream); }

  .hero-split {
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-20) var(--space-16);
    text-align: left;
    position: relative;
    overflow: hidden;
  }

  /* Dot grid background */
  .hero-dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(0.760 0.210 150 / 0.18) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 80% at 60% 50%, black 40%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-visual-col {
    position: relative;
    z-index: 1;
    padding: var(--space-8) 0;
  }

  /* Override centred defaults for split layout */
  .hero-title-left {
    text-align: left;
    max-width: 600px;
    margin-bottom: var(--space-6);
  }
  .hero-subtitle-left {
    text-align: left;
    margin-bottom: var(--space-10);
  }
  .hero-actions-left {
    justify-content: flex-start;
  }

  @media (max-width: 1023px) {
    .hero-split {
      grid-template-columns: 1fr;
      text-align: center;
      padding: var(--space-16) var(--space-6);
      min-height: auto;
    }
    .hero-title-left,
    .hero-subtitle-left { text-align: center; max-width: 100%; }
    .hero-actions-left  { justify-content: center; }
    .hero-visual-col    { display: none; }
    .hero-dot-grid { mask-image: none; }
  }
  .section-green { background: var(--card-green); }
  .section-muted { background: var(--muted); }

  .muted-label { color: var(--card-text-muted); }
  .muted-title { color: var(--card-text); }
  .muted-desc  { color: var(--card-text-muted); }

  .logo-placeholder {
    height: 28px;
    background: var(--muted);
    border-radius: var(--radius-sm);
  }

  .services-intro { margin-bottom: var(--space-6); }

  .feature-checklist {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--card-text-muted);
    font-size: var(--text-caption);
  }
  .feature-checklist li::before {
    content: "✓ ";
    font-weight: var(--weight-700);
  }

  .feature-cta {
    margin-top: var(--space-4);
    font-size: var(--text-caption);
    font-weight: var(--weight-600);
    color: var(--primary-text);
  }

  .section-header-center { text-align: center; }
  .section-header-center .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .results-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }
  .results-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .cta-email-btn { border-color: var(--gray-700); color: var(--gray-200); }
  .cta-footnote  { color: var(--gray-600); margin-top: var(--space-6); }

  @media (max-width: 767px) {
    .results-layout { grid-template-columns: 1fr; }
  }
</style>
