---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Stack10"
  description="Talk to Stack10 about your AI transformation. No sales pitch, no retainer pressure — just a direct conversation about what's possible."
  canonicalUrl="https://stack10.ai/contact/"
>

  <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
  <section class="section contact-body">
    <div class="container">
      <div class="contact-grid">

        <!-- LEFT: CONTEXT ────────────────────────────────────────────── -->
        <aside class="contact-context-col" data-reveal>

          <span class="eyebrow contact-eyebrow">Get in touch</span>
          <h1 class="h1 contact-h1">Tell us what you're working on.</h1>
          <p class="p1 contact-sub">
            No pitch. No pressure. Just a direct conversation about whether we're the right fit — and what we'd do first.
          </p>

          <!-- What to expect -->
          <div class="context-block">
            <h2 class="h5 context-heading">What to expect</h2>
            <ul class="expect-list">
              <li class="expect-item">
                <span class="expect-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="p2">We'll respond within 1 business day.</span>
              </li>
              <li class="expect-item">
                <span class="expect-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="p2">First call is 30 minutes. No slides, no pitch.</span>
              </li>
              <li class="expect-item">
                <span class="expect-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="p2">If we're not the right fit, we'll tell you — and point you somewhere better.</span>
              </li>
              <li class="expect-item">
                <span class="expect-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="p2">Fixed-fee engagements only. No retainers, no hourly billing surprises.</span>
              </li>
            </ul>
          </div>

          <!-- Location -->
          <p class="caption contact-location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Based in Australia, working globally
          </p>

          <!-- Testimonial card -->
          <blockquote class="card context-quote-card">
            <p class="context-quote-text">
              "Stack10 identified four AI opportunities we'd never considered — and shipped the first one in six weeks."
            </p>
            <footer class="context-quote-attribution">
              <span class="context-quote-role">Chief Operating Officer</span>
              <span class="context-quote-org">PE-backed Healthcare Group</span>
            </footer>
          </blockquote>

        </aside><!-- /contact-context-col -->

        <!-- RIGHT: FORM ──────────────────────────────────────────────── -->
        <div class="contact-form-col" data-reveal>

          <!-- Form state: default -->
          <form
            id="contact-form"
            class="contact-form"
            method="POST"
            action="/api/contact"
            novalidate
          >

            <!-- Row 1: Name + Company -->
            <div class="form-row form-row-2">
              <div class="form-field">
                <label class="label" for="cf-name">Name <span class="required-mark" aria-hidden="true">*</span></label>
                <input
                  class="input"
                  type="text"
                  id="cf-name"
                  name="name"
                  autocomplete="name"
                  required
                  placeholder="Alex Chen"
                />
                <p class="help-text contact-field-error" id="cf-name-error" role="alert"></p>
              </div>
              <div class="form-field">
                <label class="label" for="cf-company">Company <span class="required-mark" aria-hidden="true">*</span></label>
                <input
                  class="input"
                  type="text"
                  id="cf-company"
                  name="company"
                  autocomplete="organization"
                  required
                  placeholder="Acme Corp"
                />
                <p class="help-text contact-field-error" id="cf-company-error" role="alert"></p>
              </div>
            </div>

            <!-- Row 2: Role + Email -->
            <div class="form-row form-row-2">
              <div class="form-field">
                <label class="label" for="cf-role">Role / Title</label>
                <input
                  class="input"
                  type="text"
                  id="cf-role"
                  name="role"
                  autocomplete="organization-title"
                  placeholder="CTO"
                />
                <p class="help-text contact-field-error" id="cf-role-error" role="alert"></p>
              </div>
              <div class="form-field">
                <label class="label" for="cf-email">Email <span class="required-mark" aria-hidden="true">*</span></label>
                <input
                  class="input"
                  type="email"
                  id="cf-email"
                  name="email"
                  autocomplete="email"
                  required
                  placeholder="alex@acmecorp.com"
                />
                <p class="help-text contact-field-error" id="cf-email-error" role="alert"></p>
              </div>
            </div>

            <!-- Row 3: Phone + Annual Revenue -->
            <div class="form-row form-row-2">
              <div class="form-field">
                <label class="label" for="cf-phone">Phone</label>
                <input
                  class="input"
                  type="tel"
                  id="cf-phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+61 400 000 000"
                />
                <p class="help-text contact-field-error" id="cf-phone-error" role="alert"></p>
              </div>
              <div class="form-field">
                <label class="label" for="cf-revenue">Annual Revenue</label>
                <div class="select-wrapper">
                  <select class="input contact-select" id="cf-revenue" name="revenue">
                    <option value="">Select range</option>
                    <option value="under-50m">Under $50M</option>
                    <option value="50m-150m">$50M – $150M</option>
                    <option value="150m-500m">$150M – $500M</option>
                    <option value="500m-plus">$500M+</option>
                    <option value="prefer-not">Prefer not to say</option>
                  </select>
                  <svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
                <p class="help-text contact-field-error" id="cf-revenue-error" role="alert"></p>
              </div>
            </div>

            <!-- What are you looking for? (dropdown) -->
            <div class="form-field">
              <label class="label" for="cf-intent">What are you looking for? <span class="required-mark" aria-hidden="true">*</span></label>
              <div class="select-wrapper">
                <select class="input contact-select" id="cf-intent" name="intent" required>
                  <option value="">Select an area</option>
                  <option value="ai-strategy">AI strategy &amp; opportunity discovery</option>
                  <option value="ai-build">Custom AI system development</option>
                  <option value="ai-enablement">AI team training &amp; enablement</option>
                  <option value="data-infra">Data infrastructure &amp; integration</option>
                  <option value="ai-audit">AI audit or second opinion</option>
                  <option value="other">Not sure yet — want to explore</option>
                </select>
                <svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
              <p class="help-text contact-field-error" id="cf-intent-error" role="alert"></p>
            </div>

            <!-- Describe what you are looking for -->
            <div class="form-field">
              <label class="label" for="cf-message">Describe what you're looking for <span class="required-mark" aria-hidden="true">*</span></label>
              <textarea
                class="input contact-textarea"
                id="cf-message"
                name="message"
                rows="5"
                required
                placeholder="Tell us about the problem, what you've tried, and where you're stuck."
              ></textarea>
              <p class="help-text contact-field-error" id="cf-message-error" role="alert"></p>
            </div>

            <!-- How did you hear about us? -->
            <div class="form-field">
              <label class="label" for="cf-source">How did you hear about us?</label>
              <div class="select-wrapper">
                <select class="input contact-select" id="cf-source" name="source">
                  <option value="">Select an option</option>
                  <option value="google">Google search</option>
                  <option value="linkedin">LinkedIn</option>
                  <option value="word-of-mouth">Word of mouth</option>
                  <option value="conference">Conference or event</option>
                  <option value="case-study">Case study</option>
                  <option value="other">Other</option>
                </select>
                <svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
              <p class="help-text contact-field-error" id="cf-source-error" role="alert"></p>
            </div>

            <button type="submit" class="btn btn-primary btn-lg contact-submit">
              Send message
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
              </svg>
            </button>

          </form>

          <!-- Form state: success -->
          <div id="contact-success" class="contact-success" hidden>
            <div class="success-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h3 class="h4 success-heading">We've got it.</h3>
            <p class="p2 success-body">
              We'll be in touch within one business day. In the meantime, feel free to read the
              <a href="/case-studies/smile-partners/" class="success-link">our healthcare group case study</a>.
            </p>
          </div>

        </div><!-- /contact-form-col -->

      </div><!-- /contact-grid -->
    </div>
  </section>

  <!-- ── SEPARATOR ────────────────────────────────────────────── -->
  <div class="container">
    <div class="gradient-line" aria-hidden="true"></div>
  </div>

  <!-- ── NOT READY YET ────────────────────────────────────────── -->
  <section class="section contact-alt" data-reveal>
    <div class="container">
      <h2 class="h4 contact-alt-heading">Not ready to reach out yet?</h2>
      <div class="contact-alt-cards">

        <a href="/case-studies/smile-partners/" class="card card-clickable contact-alt-card">
          <div class="contact-alt-card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div>
            <h3 class="h5 contact-alt-card-title">Read a case study</h3>
            <p class="p2 contact-alt-card-desc">See how Stack10 deployed four AI systems across a $111M healthcare group in twelve weeks.</p>
          </div>
          <svg class="contact-alt-card-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
          </svg>
        </a>

        <a href="/#products" class="card card-clickable contact-alt-card">
          <div class="contact-alt-card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
          </div>
          <div>
            <h3 class="h5 contact-alt-card-title">Explore our products</h3>
            <p class="p2 contact-alt-card-desc">Stack Discover, Stack Build, and Stack Scale — fixed-fee engagements designed to move fast.</p>
          </div>
          <svg class="contact-alt-card-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
          </svg>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>


<!-- ── CLIENT-SIDE FORM STATE ──────────────────────────────── -->
<script>
  import { contactSchema } from '../../lib/contactSchema';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-success') as HTMLElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (!form || !success) throw new Error('Contact form elements not found');

  // Map each field name to its error paragraph
  const errorEls: Record<string, HTMLElement | null> = {
    name:    document.getElementById('cf-name-error'),
    company: document.getElementById('cf-company-error'),
    role:    document.getElementById('cf-role-error'),
    email:   document.getElementById('cf-email-error'),
    phone:   document.getElementById('cf-phone-error'),
    revenue: document.getElementById('cf-revenue-error'),
    intent:  document.getElementById('cf-intent-error'),
    message: document.getElementById('cf-message-error'),
    source:  document.getElementById('cf-source-error'),
  };

  function clearErrors() {
    for (const el of Object.values(errorEls)) {
      if (el) { el.textContent = ''; }
    }
    form!.querySelectorAll('.input').forEach((f) => f.classList.remove('input-error'));
  }

  function showErrors(fieldErrors: Record<string, string[] | undefined>) {
    for (const [field, messages] of Object.entries(fieldErrors)) {
      if (!messages?.length) continue;
      const el = errorEls[field];
      if (el) { el.textContent = messages[0]; }
      const input = form!.querySelector(`[name="${field}"]`);
      if (input) { input.classList.add('input-error'); }
    }
  }

  function showSuccess() {
    form!.style.opacity = '0';
    form!.style.transition = 'opacity 0.2s ease';
    setTimeout(() => {
      form!.hidden = true;
      success!.hidden = false;
      success!.style.opacity = '0';
      success!.style.transition = 'opacity 0.3s ease';
      requestAnimationFrame(() => { success!.style.opacity = '1'; });
    }, 200);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    // ── Client-side Zod validation ─────────────────────────────
    const raw = Object.fromEntries(new FormData(form));
    const result = contactSchema.safeParse(raw);

    if (!result.success) {
      showErrors(result.error.flatten().fieldErrors as Record<string, string[]>);
      // Focus first invalid field
      const firstErrorField = Object.keys(result.error.flatten().fieldErrors)[0];
      form.querySelector<HTMLElement>(`[name="${firstErrorField}"]`)?.focus();
      return;
    }

    // ── Submit to API ──────────────────────────────────────────
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(raw),
      });

      if (res.ok) {
        showSuccess();
        return;
      }

      if (res.status === 422) {
        const body = await res.json();
        if (body.fields) showErrors(body.fields);
        return;
      }

      if (res.status === 429) {
        alert('Too many requests. Please wait a few minutes and try again.');
        return;
      }

      alert('Something went wrong. Please try again or email us directly.');
    } catch {
      alert('Network error. Please check your connection and try again.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `Send message
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
          </svg>`;
      }
    }
  });

  // Clear individual field error on change
  form.querySelectorAll<HTMLElement>('.input').forEach((field) => {
    field.addEventListener('input', () => {
      field.classList.remove('input-error');
      const name = (field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).name;
      const el = errorEls[name];
      if (el) el.textContent = '';
    });
  });
</script>


<style>
  /* ── Body ───────────────────────────────────────────────────── */

  .contact-body {
    padding-top: var(--space-12);
  }

  /* ── Two-column grid ────────────────────────────────────────── */

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: var(--space-16);
    }
  }

  @media (min-width: 1100px) {
    .contact-grid {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-20);
    }
  }

  /* ── Scroll reveal ──────────────────────────────────────────── */

  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: none;
  }

  .contact-form-col[data-reveal] {
    transition-delay: 120ms;
  }

  /* ── Left context column ────────────────────────────────────── */

  .contact-context-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: sticky;
    top: calc(var(--nav-height, 4rem) + var(--space-8));
  }

  /* Un-stick on mobile */
  @media (max-width: 767px) {
    .contact-context-col {
      position: static;
    }
  }

  .contact-eyebrow {
    display: inline-block;
    color: var(--primary-text);
    letter-spacing: 0.12em;
  }

  .contact-h1 {
    margin: 0;
    line-height: 1.1;
  }

  .contact-sub {
    color: var(--muted-foreground);
    margin: 0;
    max-width: 44ch;
  }

  /* ── What to expect ─────────────────────────────────────────── */

  .context-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .context-heading {
    margin: 0;
    color: var(--foreground);
  }

  .expect-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .expect-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .expect-check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--primary-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15em;
  }

  .expect-item .p2 {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.55;
  }

  /* ── Location ───────────────────────────────────────────────── */

  .contact-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted-foreground);
    margin: 0;
  }

  /* ── Testimonial card ───────────────────────────────────────── */

  .context-quote-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    border-left: 3px solid var(--primary);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
  }

  .context-quote-text {
    font-size: var(--size-base);
    font-weight: var(--weight-500);
    color: var(--foreground);
    line-height: 1.65;
    margin: 0;
    font-style: italic;
  }

  .context-quote-attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .context-quote-role {
    font-size: var(--size-sm);
    font-weight: var(--weight-600);
    color: var(--foreground);
  }

  .context-quote-org {
    font-size: var(--size-sm);
    color: var(--muted-foreground);
  }

  /* ── Form column ────────────────────────────────────────────── */

  .contact-form-col {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  @media (min-width: 640px) {
    .contact-form-col {
      padding: var(--space-10);
    }
  }

  /* ── Form ───────────────────────────────────────────────────── */

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 480px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .required-mark {
    color: var(--destructive);
    margin-left: 2px;
  }

  .contact-field-error {
    color: var(--destructive);
    min-height: 0;
    margin: 0;
  }

  .contact-field-error:empty {
    display: none;
  }

  .contact-textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.6;
  }

  /* Select wrapper */
  .select-wrapper {
    position: relative;
  }

  .contact-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    cursor: pointer;
    padding-right: var(--space-10);
  }

  .select-chevron {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--muted-foreground);
  }

  .contact-submit {
    width: 100%;
    justify-content: center;
    margin-top: var(--space-2);
  }

  /* ── Success state ──────────────────────────────────────────── */

  .contact-success {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-10) var(--space-8);
  }

  /* Ensure HTML hidden attribute is respected even with display:flex above */
  .contact-success[hidden] {
    display: none;
  }

  .success-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--primary-foreground);
    display: flex;
    align-items: center;
